# Kuapa Dwaso staging env template.
# Copy into the staging Infisical environment and replace placeholders.
# Staging deployments still run production builds, so NODE_ENV stays production.

# Runtime
NODE_ENV=production
PORT=4000

# Convex provider config / public client value
CONVEX_URL=<set-staging-convex-url>
NEXT_PUBLIC_CONVEX_URL=<set-staging-convex-url>

# Firebase Admin server secrets / provider config
FIREBASE_PROJECT_ID=<set-staging-firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON=<set-in-infisical>

# Firebase Web public client values
NEXT_PUBLIC_FIREBASE_API_KEY=<set-staging-firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<set-staging-firebase-auth-domain>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<set-staging-firebase-project-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<set-staging-firebase-app-id>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<set-staging-firebase-sender-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<set-staging-firebase-storage-bucket>

# Deployment URLs
# PUBLIC_API_URL is provider-doctor-only fallback text for webhook URL output.
PUBLIC_APP_URL=https://app.staging.<your-domain>
NEXT_PUBLIC_API_URL=https://api.staging.<your-domain>
PUBLIC_API_URL=https://api.staging.<your-domain>

# Email provider config / server secrets
RESEND_API_KEY=<set-in-infisical>
RESEND_FROM_EMAIL=Kuapa Dwaso Staging <invites-staging@<your-domain>>

# SMS provider config / server secrets
# Use arkesel for provider staging; switch to mock only for isolated non-provider smoke environments.
SMS_PROVIDER=arkesel
SMS_FROM_NAME=KuapaDwaso
ARKESEL_SMS_API_KEY=<set-in-infisical>
ARKESEL_WEBHOOK_SIGNATURE_HEADER=x-arkesel-signature
ARKESEL_WEBHOOK_SIGNATURE_SECRET=<set-in-infisical-or-confirm-unsigned>

# Notification delivery server secret
NOTIFICATION_DELIVERY_SECRET=<set-in-infisical>

# Payment provider config / server secrets
# Paystack test keys are expected for MVP/demo staging.
PAYMENT_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY=<set-staging-paystack-public-key>
PAYSTACK_SECRET_KEY=<set-in-infisical>
PAYSTACK_WEBHOOK_SECRET=<set-in-infisical>

# Private Cloudflare R2 provider config / server secrets
# Buckets must stay private. Do not configure CLOUDFLARE_R2_PUBLIC_BASE_URL.
CLOUDFLARE_R2_ACCOUNT_ID=<set-staging-r2-account-id>
CLOUDFLARE_R2_ACCESS_KEY_ID=<set-in-infisical>
CLOUDFLARE_R2_SECRET_ACCESS_KEY=<set-in-infisical>
CLOUDFLARE_R2_BUCKET=<set-staging-private-bucket>
R2_PRESIGN_TTL_SECONDS=900
R2_READ_PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_SIZE_BYTES=8388608

# API abuse guard config
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_INVITE_SEND_MAX=20
API_RATE_LIMIT_UPLOAD_PRESIGN_MAX=60

# Local/dev-only switches
API_AUTH_DISABLED=false
NEXT_PUBLIC_ENABLE_DEV_ACTOR_FALLBACK=false
NEXT_PUBLIC_OPS_ACTOR_USER_ID=

# Tooling-only values
PROVIDER_DOCTOR_MODE=production
SMOKE_RUN_ID=
SMOKE_CLEANUP_RUN_ID=
