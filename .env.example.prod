# Kuapa Dwaso production env template.
# Copy into the production Infisical environment and replace placeholders.
# Do not commit real values. Values marked public client value are exposed to
# browser bundles, but they still must be injected into the correct deployed app.

# Runtime
NODE_ENV=production
PORT=4000

# Convex provider config / public client value
# CONVEX_URL is server-side for the API and tooling.
# NEXT_PUBLIC_CONVEX_URL is public and must point at the same production Convex deployment.
CONVEX_URL=<set-production-convex-url>
NEXT_PUBLIC_CONVEX_URL=<set-production-convex-url>

# Firebase Admin server secrets / provider config
FIREBASE_PROJECT_ID=<set-production-firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=<set-base64-json-in-infisical>

# Firebase Web public client values
# Used by apps/app, apps/admin, and apps/ops for browser authentication.
NEXT_PUBLIC_FIREBASE_API_KEY=<set-production-firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<set-production-firebase-auth-domain>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<set-production-firebase-project-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<set-production-firebase-app-id>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<set-production-firebase-sender-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<set-production-firebase-storage-bucket>
# Comma-separated HTTPS origins checked against Firebase before image publication.
FIREBASE_AUTH_ORIGINS=https://app.<your-production-domain>,https://ops.<your-production-domain>,https://admin.<your-production-domain>

# Deployment URLs
# PUBLIC_APP_URL is server-side and is used by API invite templates.
# NEXT_PUBLIC_API_URL is public and is used by browser apps for API calls.
# PUBLIC_API_URL is provider-doctor-only fallback text for webhook URL output.
PUBLIC_APP_URL=https://app.<your-production-domain>
NEXT_PUBLIC_API_URL=https://api.<your-production-domain>
PUBLIC_API_URL=https://api.<your-production-domain>

# Email provider config / server secrets
RESEND_API_KEY=<set-in-infisical>
RESEND_FROM_EMAIL=Kuapa Dwaso <invites@<your-production-domain>>

# SMS provider config / server secrets
SMS_PROVIDER=arkesel
SMS_FROM_NAME=KuapaDwaso
ARKESEL_SMS_API_KEY=<set-in-infisical>
ARKESEL_WEBHOOK_SIGNATURE_HEADER=x-arkesel-signature
# Leave unset only if Arkesel confirms delivery reports are unsigned.
ARKESEL_WEBHOOK_SIGNATURE_SECRET=<set-in-infisical-or-confirm-unsigned>

# Notification delivery server secret
# Workers calling /sms/webhooks/deliveries/process must send this value as
# x-notification-delivery-secret.
NOTIFICATION_DELIVERY_SECRET=<set-in-infisical>

# Payment provider config / server secrets
PAYMENT_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY=<set-production-paystack-public-key>
PAYSTACK_SECRET_KEY=<set-in-infisical>
PAYSTACK_WEBHOOK_SECRET=<set-in-infisical>

# Private Cloudflare R2 provider config / server secrets
# Buckets must stay private. Do not configure CLOUDFLARE_R2_PUBLIC_BASE_URL.
CLOUDFLARE_R2_ACCOUNT_ID=<set-production-r2-account-id>
CLOUDFLARE_R2_ACCESS_KEY_ID=<set-in-infisical>
CLOUDFLARE_R2_SECRET_ACCESS_KEY=<set-in-infisical>
CLOUDFLARE_R2_BUCKET=<set-production-private-bucket>
CLOUDFLARE_TUNNEL_TOKEN=<set-production-cloudflare-dashboard-tunnel-token-in-infisical>
R2_PRESIGN_TTL_SECONDS=900
R2_READ_PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_SIZE_BYTES=8388608

# API abuse guard config
# Current implementation is per API process. Use conservative values until a
# shared Redis/edge-backed rate-limit store replaces it.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_INVITE_SEND_MAX=20
API_RATE_LIMIT_UPLOAD_PRESIGN_MAX=60

# Local/dev-only switches
# API_AUTH_DISABLED is ignored in production by apps/api/src/config/env.ts.
API_AUTH_DISABLED=false
NEXT_PUBLIC_ENABLE_DEV_ACTOR_FALLBACK=false
NEXT_PUBLIC_OPS_ACTOR_USER_ID=

# Tooling-only values
# PROVIDER_DOCTOR_MODE can be exported when running corepack pnpm provider:doctor.
# SMOKE_* values are only for explicit smoke cleanup runs.
PROVIDER_DOCTOR_MODE=production
SMOKE_RUN_ID=
SMOKE_CLEANUP_RUN_ID=
