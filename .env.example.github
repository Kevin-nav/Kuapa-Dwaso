# GitHub Environment setup template for Kuapa Dwaso.
# Use one copy for the `staging` GitHub Environment and one copy for
# `production`. Do not commit real values here.
#
# Values marked "GitHub Environment secret" go in Settings -> Environments ->
# <environment> -> Environment secrets.
#
# Values marked "GitHub Environment variable" go in Settings -> Environments ->
# <environment> -> Environment variables.
#
# Values marked "Infisical" do not go in GitHub. They are listed here because
# the image build pulls them from Infisical before building browser bundles.

# Required GitHub Environment secrets
VPS_DEPLOY_HOST=<set-vps-hostname-or-ip>
VPS_DEPLOY_USER=<set-restricted-deploy-user>
VPS_DEPLOY_SSH_KEY=<set-private-key-for-restricted-deploy-user>
INFISICAL_CLIENT_ID=<set-infisical-machine-identity-client-id>
INFISICAL_CLIENT_SECRET=<set-infisical-machine-identity-client-secret>

# Optional GitHub Environment secrets
VPS_DEPLOY_PORT=22
VPS_DEPLOY_KNOWN_HOSTS=<recommended-known-hosts-line-from-ssh-keyscan>

# Required GitHub Environment variables
INFISICAL_PROJECT_ID=<set-infisical-project-id>

# Optional GitHub Environment variables with defaults
IMAGE_REGISTRY=ghcr.io
IMAGE_REPOSITORY_PREFIX=ghcr.io/<owner>/<repo>
KUBE_NAMESPACE=kuapa-dwaso-<environment>
KUSTOMIZE_OVERLAY_PATH=deploy/k8s/overlays/<environment>
VPS_DEPLOY_WORKDIR=~/kuapa-dwaso
ALLOW_MISSING_KUSTOMIZE_OVERLAY=true
INFISICAL_ENVIRONMENT_SLUG=<environment>
INFISICAL_SECRET_PATH=/
INFISICAL_SYNC_REQUIRED=false
K8S_RUNTIME_SECRET_NAME=kuapa-dwaso-runtime-env
K8S_IMAGE_NAME_WWW=kuapa-dwaso/www
K8S_IMAGE_NAME_APP=kuapa-dwaso/app
K8S_IMAGE_NAME_ADMIN=kuapa-dwaso/admin
K8S_IMAGE_NAME_OPS=kuapa-dwaso/ops
K8S_IMAGE_NAME_API=kuapa-dwaso/api

# Infisical build-time values pulled by GitHub Actions before image builds
NEXT_PUBLIC_CONVEX_URL=<set-in-infisical>
NEXT_PUBLIC_API_URL=<set-in-infisical>
NEXT_PUBLIC_FIREBASE_API_KEY=<set-in-infisical>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<set-in-infisical>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<set-in-infisical>
NEXT_PUBLIC_FIREBASE_APP_ID=<set-in-infisical>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<set-in-infisical>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<set-in-infisical>
