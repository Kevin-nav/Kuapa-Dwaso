# Copy this file to the repo root as `.env.local` for local development.
# The Next apps and API load root `.env.local` first, then root `.env`.
# Next app scripts then load app-local env files as optional overrides.
# Deployment platform env vars still work and should be configured per app/service.

# Convex
# `corepack pnpm convex:dev` writes these values to the root `.env.local`.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# API auth
# `API_AUTH_DISABLED=true` only works outside production.
API_AUTH_DISABLED=
FIREBASE_PROJECT_ID=
# Base64-encode the Firebase service account JSON file before storing it.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Temporary shared profile access. Keep the UIDs server-only, choose an exact
# UTC cutoff, and turn both flags off as the first shutdown step.
PREVIEW_ACCESS_ENABLED=false
PREVIEW_ACCESS_CUTOFF_UTC=
PREVIEW_ACCESS_FARMER_FIREBASE_UID=
PREVIEW_ACCESS_BUYER_FIREBASE_UID=
PREVIEW_ACCESS_TRANSPORTER_FIREBASE_UID=
PREVIEW_ACCESS_WAREHOUSE_AGENT_FIREBASE_UID=

# Manual shared-profile provisioning. Keep phone numbers and UIDs out of git.
# Setup is a dry run unless --execute and the exact confirmation are supplied.
PREVIEW_SETUP_CONVEX_URL=
PREVIEW_SETUP_ADMIN_FIREBASE_UID=
PREVIEW_FARMER_PHONE_NUMBER=
PREVIEW_BUYER_PHONE_NUMBER=
PREVIEW_TRANSPORTER_PHONE_NUMBER=
PREVIEW_OPERATIONS_PHONE_NUMBER=
PREVIEW_CLEANUP_DEPLOYMENT=
PREVIEW_CLEANUP_PROGRAMME_ID=
PREVIEW_CLEANUP_START_AT=
PREVIEW_CLEANUP_END_AT=
PREVIEW_FARMER_USER_ID=
PREVIEW_BUYER_USER_ID=
PREVIEW_TRANSPORTER_USER_ID=
PREVIEW_OPERATIONS_USER_ID=
PREVIEW_BACKGROUND_FARMER_USER_IDS=

# API invite delivery
PUBLIC_APP_URL=http://localhost:3000
PRODUCT_APP_URL=http://localhost:3001
# API CORS allowed origins (comma-separated). Fallback is staging domains.
# API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMS_PROVIDER=mock
WEB_PUSH_PROVIDER=mock
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=
SMS_FROM_NAME=KuapaDwaso
ARKESEL_SMS_API_KEY=
ARKESEL_WEBHOOK_SIGNATURE_HEADER=x-arkesel-signature
ARKESEL_WEBHOOK_SIGNATURE_SECRET=
# While shared profile access is enabled, outbound SMS fails closed unless the
# normalized recipient is in this team-controlled allowlist. Limits count SMS
# segments per recipient per UTC hour.
PREVIEW_SMS_RECIPIENT_ALLOWLIST=
PREVIEW_SMS_HOURLY_SEGMENT_LIMIT=12
PREVIEW_SMS_HIGH_CAPACITY_UTC_DATES=2026-09-17
PREVIEW_SMS_HIGH_CAPACITY_HOURLY_SEGMENT_LIMIT=120

# API private payment provider boundary
# MVP/demo defaults to mock. Paystack keys must stay API-only.
PAYMENT_PROVIDER=mock
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# API upload provider boundary (Cloudflare R2 / S3-compatible).
# Keep operational evidence in the private bucket. The public bucket is only
# for approved listing and blog media exposed through the configured asset domain.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
R2_PRESIGN_TTL_SECONDS=900
R2_READ_PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_SIZE_BYTES=8388608

# API abuse guards
# In-memory per API process today; use conservative values in staging/prod
# until a shared Redis/edge-backed store replaces it.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_INVITE_SEND_MAX=20
API_RATE_LIMIT_UPLOAD_PRESIGN_MAX=60
API_RATE_LIMIT_PREVIEW_SESSION_MAX=30

# Backend smoke cleanup
# Usage: SMOKE_RUN_ID=<run id> corepack pnpm smoke:backend:cleanup -- --confirm
SMOKE_RUN_ID=

# Next.js client apps read only `NEXT_PUBLIC_*` values into browser bundles.
# Keep API secrets above out of `NEXT_PUBLIC_*`.
NEXT_PUBLIC_CONVEX_URL=

# Next.js authenticated client apps use Firebase public web config for browser auth.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Client invite acceptance posts Firebase ID tokens to the API.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PWA_DEV=false
NEXT_PUBLIC_PREVIEW_ACCESS_ENABLED=false
NEXT_PUBLIC_PREVIEW_PROGRAMME_ID=
# Optional public R2/custom-domain origin. Leave empty to use the bundled WebP files.
NEXT_PUBLIC_PREVIEW_PROFILE_ASSET_BASE_URL=

# Ops can fall back to a manual Convex user id only for local development.
NEXT_PUBLIC_ENABLE_DEV_ACTOR_FALLBACK=false
NEXT_PUBLIC_OPS_ACTOR_USER_ID=
