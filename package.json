{
  "name": "kuapa-dwaso",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "turbo dev",
    "dev:www": "pnpm --filter @kuapa-dwaso/www dev",
    "dev:app": "pnpm --filter @kuapa-dwaso/app dev",
    "dev:ops": "pnpm --filter @kuapa-dwaso/ops dev",
    "dev:admin": "pnpm --filter @kuapa-dwaso/admin dev",
    "dev:api": "pnpm --filter @kuapa-dwaso/api dev",
    "convex:dev": "convex dev",
    "convex:dev:once": "convex dev --once",
    "convex:deploy": "convex deploy",
    "smoke:backend": "pnpm --filter @kuapa-dwaso/test-utils smoke:backend",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "turbo format"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.9",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.5.2"
  },
  "dependencies": {
    "@kuapa-dwaso/permissions": "workspace:*",
    "@kuapa-dwaso/types": "workspace:*",
    "@kuapa-dwaso/utils": "workspace:*",
    "convex": "1.41.0"
  }
}
