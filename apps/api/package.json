{
  "name": "@kuapa-dwaso/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --experimental-strip-types dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@kuapa-dwaso/permissions": "workspace:*",
    "@kuapa-dwaso/types": "workspace:*",
    "@kuapa-dwaso/utils": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "convex": "1.41.0",
    "firebase-admin": "^14.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@kuapa-dwaso/eslint-config": "workspace:*",
    "@kuapa-dwaso/typescript-config": "workspace:*",
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
