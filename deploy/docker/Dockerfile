# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /repo
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps ./apps
COPY packages ./packages
RUN corepack pnpm install --frozen-lockfile

FROM deps AS builder
ARG APP_SCOPE
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_CONVEX_URL
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ARG NEXT_PUBLIC_ENABLE_DEV_ACTOR_FALLBACK=false
ARG NEXT_PUBLIC_OPS_ACTOR_USER_ID=
ARG NEXT_PUBLIC_PREVIEW_ACCESS_ENABLED=false
ARG NEXT_PUBLIC_PREVIEW_PROGRAMME_ID=
ARG NEXT_PUBLIC_PREVIEW_PROFILE_ASSET_BASE_URL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_CONVEX_URL=$NEXT_PUBLIC_CONVEX_URL
ENV NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID
ENV NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID
ENV NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ENV NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ENV NEXT_PUBLIC_ENABLE_DEV_ACTOR_FALLBACK=$NEXT_PUBLIC_ENABLE_DEV_ACTOR_FALLBACK
ENV NEXT_PUBLIC_OPS_ACTOR_USER_ID=$NEXT_PUBLIC_OPS_ACTOR_USER_ID
ENV NEXT_PUBLIC_PREVIEW_ACCESS_ENABLED=$NEXT_PUBLIC_PREVIEW_ACCESS_ENABLED
ENV NEXT_PUBLIC_PREVIEW_PROGRAMME_ID=$NEXT_PUBLIC_PREVIEW_PROGRAMME_ID
ENV NEXT_PUBLIC_PREVIEW_PROFILE_ASSET_BASE_URL=$NEXT_PUBLIC_PREVIEW_PROFILE_ASSET_BASE_URL
RUN corepack pnpm --filter "$APP_SCOPE" build

FROM base AS runtime
ARG APP_SCOPE
ARG APP_DIR
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
COPY --from=builder /repo/package.json /repo/pnpm-lock.yaml /repo/pnpm-workspace.yaml ./
COPY --from=builder /repo/apps ./apps
COPY --from=builder /repo/packages ./packages
RUN corepack pnpm install --prod --frozen-lockfile --filter "$APP_SCOPE"... \
  && corepack pnpm store prune
WORKDIR /repo/apps/${APP_DIR}
CMD ["corepack", "pnpm", "start"]
